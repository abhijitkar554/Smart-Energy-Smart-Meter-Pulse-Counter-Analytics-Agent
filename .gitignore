# =============================================================================
#  Smart Energy Meter — .gitignore
# =============================================================================

# ── Build artefacts ───────────────────────────────────────────────────────────
build/
*.o
*.a
*.exe
*.dll

# ── Runtime data — never commit DB files or log dumps ─────────────────────────
data/*.db
data/*.db-wal
data/*.db-shm
data/*.txt          # all output/log text files
data/demo_energy.db
data/test_energy.db
data/energy.db

# ── Windows helper scripts (hardcode paths / not portable) ───────────────────
do_push.bat
run.bat

# ── IDE / OS artefacts ────────────────────────────────────────────────────────
.vscode/
.vs/
*.user
*.suo
.DS_Store
Thumbs.db

# ── Compiler pre-compiled headers ─────────────────────────────────────────────
*.pch
*.gch
